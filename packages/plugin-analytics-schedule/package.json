{
  "name": "@elizaos/plugin-analytics-schedule",
  "description": "ElizaOS plugin for polling platform analytics and proposing posting schedules",
  "version": "1.5.7",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "packageType": "plugin",
  "platform": "node",
  "license": "MIT",
  "author": "ElizaOS",
  "keywords": [
    "plugin",
    "elizaos",
    "analytics",
    "schedule",
    "social-media"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/elizaos/eliza"
  },
  "homepage": "https://elizaos.ai",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "package.json"
  ],
  "dependencies": {
    "@elizaos/core": "workspace:*",
    "zod": "3.24.2"
  },
  "devDependencies": {
    "typescript": "5.8.2"
  },
  "scripts": {
    "build": "bun run build.ts",
    "lint": "prettier --write ./src",
    "format": "prettier --write ./src",
    "format:check": "prettier --check ./src"
  },
  "publishConfig": {
    "access": "public"
  },
  "agentConfig": {
    "pluginType": "elizaos:plugin:1.0.0",
    "pluginParameters": {
      "ANALYTICS_API_ENDPOINT": {
        "type": "string",
        "description": "The endpoint URL to poll for platform analytics data"
      },
      "ANALYTICS_API_KEY": {
        "type": "string",
        "description": "API key for authenticating with the analytics endpoint (optional)"
      },
      "ANALYTICS_POLL_INTERVAL_MS": {
        "type": "number",
        "description": "Polling interval in milliseconds (default: 3600000 = 1 hour)"
      }
    }
  }
}
